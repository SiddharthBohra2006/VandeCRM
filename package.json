{
  "name": "vandecrm-react",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev:server": "nodemon -e js,json server/src/server.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npm run build",
    "start": "node server/src/server.js"
  },
  "dependencies": {
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "jsonwebtoken": "^9.0.2",
    "lucide": "^0.468.0",
    "method-override": "^3.0.0",
    "mongoose": "^8.4.1",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
