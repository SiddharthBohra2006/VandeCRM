# ===========================================================================
# VandeCRM React — environment configuration reference
# Copy this file to `.env` (repo root) and fill in real values.
# Do NOT commit `.env`. Production REQUIRES the 4 vars marked [REQUIRED].
# ===========================================================================

# --- Server core ------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Where the React dev server runs (CORS allow-list).
CLIENT_URL=http://localhost:5173
# [REQUIRED in production] MongoDB connection string.
MONGO_URI=mongodb://127.0.0.1:27017/vande-agency-crm
# [REQUIRED in production] Signing secret for JWTs. Kept separate from SESSION_SECRET.
JWT_SECRET=change-me-to-a-long-random-string
# [REQUIRED in production] Legacy/fallback secret. Also used as JWT fallback if
# JWT_SECRET is unset — set BOTH and keep them different.
SESSION_SECRET=change-me-to-a-different-long-random-string
# [REQUIRED in production] Public origin used to build absolute links in emails
# (password reset, deadline reminders). e.g. https://crm.yourcompany.com
APP_BASE_URL=http://localhost:5000

# --- Signup / recovery ------------------------------------------------------
# Allow public workspace signup (open this only if you want self-service signups).
# Default is locked down: tenants cannot self-register without explicitly enabling it.
ALLOW_PUBLIC_SIGNUP=false
# Default workspace name/slug used by signup when the UI does not supply one.
DEFAULT_ORG_NAME=Vande Agency
DEFAULT_ORG_SLUG=vande-agency
# Optional one-time recovery: set a key AND enable ALLOW_ADMIN_RECOVERY=true to
# create a recovery admin on boot (see api/auth.js /admin-recovery).
ADMIN_RECOVERY_KEY=
ALLOW_ADMIN_RECOVERY=false

# --- Encryption ------------------------------------------------------------
# [REQUIRED in production] 32-char+ key used to encrypt stored credentials
# (integration/email passwords). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# --- Schedulers ------------------------------------------------------------
# Hourly deadline-reminder scan. 'false' disables.
DEADLINE_SCHEDULER_ENABLED=true
# Deadline reminders ALSO send email (requires the org to have an active SMTP
# EmailAccount configured under Mail settings). 'false' = in-app notifications only.
REMINDER_EMAIL_ENABLED=true
# Integration sync scheduler. 'false' disables.
INTEGRATION_SCHEDULER_ENABLED=true
# Minutes between integration sync polls.
INTEGRATION_SCHEDULER_POLL_MINUTES=5

# --- Outbound webhooks -----------------------------------------------------
# Timeout (ms) per outbound webhook HTTP attempt.
OUTBOUND_WEBHOOK_TIMEOUT_MS=8000
# Max attempts before a webhook dispatch is given up.
OUTBOUND_WEBHOOK_MAX_ATTEMPTS=3
# Outbound webhook User-Agent header (default: CRM-Webhook-Dispatcher/1.0).
WEBHOOK_USER_AGENT=CRM-Webhook-Dispatcher/1.0

# --- Meta Ads / GA4 sync --------------------------------------------------
# Optional: production credentials are stored per-company in the DB, but these
# tune the sync runs.
META_GRAPH_API_VERSION=v23.0
META_SYNC_DATE_PRESET=this_month
META_REQUEST_TIMEOUT_MS=10000
GA4_SYNC_START_DATE=30daysAgo
GA4_SYNC_END_DATE=today
GA4_SYNC_PAGE_SIZE=10000
GOOGLE_REQUEST_TIMEOUT_MS=10000

# --- SMTP timeouts (ms) -----------------------------------------------------
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000